 					return resolve_symlinks(retpath);
 				case -1:		/* wasn't even a candidate, keep looking */
 					break;
 				case -2:		/* found but disqualified */
 					log_error(errcode(ERRCODE_WRONG_OBJECT_TYPE),
-							  _("could not read binary \"%s\""),
+							  _("could not read binary \"%s\": %m"),
 							  retpath);
 					break;
 			}
 		} while (*endp);
