 		if (validate_exec(retpath) == 0)
 			return resolve_symlinks(retpath);
 
 		log_error(errcode(ERRCODE_WRONG_OBJECT_TYPE),
-				  _("invalid binary \"%s\""), retpath);
+				  _("invalid binary \"%s\": %m"), retpath);
 		return -1;
 	}
 
 #ifdef WIN32
