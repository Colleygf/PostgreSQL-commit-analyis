+	jsestate->jump_error = state->steps_len;
 	if (jsexpr->on_error &&
-		jsexpr->on_error->btype != JSON_BEHAVIOR_ERROR)
+		jsexpr->on_error->btype != JSON_BEHAVIOR_ERROR &&
