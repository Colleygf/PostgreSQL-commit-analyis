 		jumps_to_end = lappend_int(jumps_to_end, state->steps_len);
 		scratch->opcode = EEOP_JUMP_IF_NOT_TRUE;
 		scratch->resvalue = &jsestate->empty.value;
 		scratch->resnull = &jsestate->empty.isnull;
