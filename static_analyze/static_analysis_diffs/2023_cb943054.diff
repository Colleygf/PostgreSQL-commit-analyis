 			free(fname);
 			free(ln);
 		}
 	}
 	else
@@ -1237,10 +1245,17 @@ exec_command_ef_ev(PsqlScanState scan_state, bool active_branch,
 				puts(_("No changes"));
 			else
 				status = PSQL_CMD_NEWEDIT;
 		}
 
